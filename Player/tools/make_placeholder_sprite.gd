func _init() -> void:
	var sheet := Image.create(W * COLS, H * 3, false, Image.FORMAT_RGBA8)
	sheet.fill(Color(0, 0, 0, 0))
	# [grid, column where the left leg ends]
	var rows := [[DOWN, 16], [UP, 16], [SIDE, 15]]
	for row in rows.size():
		var base := _parse(rows[row][0])
		var split: int = rows[row][1]
		for col in COLS:
			var step: int = [0, 1, 0, -1][col]
			var frame := base.duplicate()
			if step != 0:
				# step 1 lifts the right-hand leg, -1 the left-hand one
				_lift_leg(frame, split if step == 1 else 0, W if step == 1 else split)
			_outline(frame)
			# body dips 1 px on step frames
			sheet.blit_rect(frame, Rect2i(0, 0, W, H), Vector2i(col * W, row * H + (1 if step != 0 else 0)))
	DirAccess.make_dir_recursive_absolute("res://Player/art")
	var err := sheet.save_png("res://Player/art/player_sheet.png")
	print("saved player_sheet.png: ", error_string(err))
	quit()


func _parse(grid: String) -> Image:
	var img := Image.create(W, H, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var lines := grid.strip_edges().split("\n")
	for y in mini(lines.size(), H):
		var line: String = lines[y]
		for x in mini(line.length(), W):
			var ch := line[x]
			if PALETTE.has(ch):
				img.set_pixel(x, y, Color(PALETTE[ch]))
	return img


## Shortens the shin of the leg between columns x0..x1 so the foot lifts.
func _lift_leg(img: Image, x0: int, x1: int) -> void:
	var src := img.duplicate()
	var cut := LEG_TOP + 4
	for x in range(x0, x1):
		for y in range(cut, H):
			var from := y + LIFT
			img.set_pixel(x, y, src.get_pixel(x, from) if from < H else Color(0, 0, 0, 0))


func _outline(img: Image) -> void:
	var src := img.duplicate()
	var ink := Color(PALETTE["K"])
	for x in W:
		for y in H:
			if src.get_pixel(x, y).a > 0.0:
				continue
			for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
				var n: Vector2i = Vector2i(x, y) + d
				# only close gaps; the grids already carry their own ink lines
				if n.x >= 0 and n.y >= 0 and n.x < W and n.y < H and src.get_pixel(n.x, n.y).a > 0.0 and src.get_pixel(n.x, n.y) != ink:
					img.set_pixel(x, y, ink)
					break
